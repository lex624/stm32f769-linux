# /etc/inittab - STM32F769I-DISCO
#
# Same as Buildroot's stock inittab except the console line: a shell is spawned
# directly instead of getty+login. Those two applets plus shadow-password support
# cost ~30 KB in busybox, and busybox must stay under 256 KB - on noMMU every
# exec needs one physically contiguous allocation the size of the whole binary,
# and above 256 KB that is an order-7 request the allocator usually cannot meet
# on a fragmented 12 MB system. root has no password anyway, so login was only
# ever asking for a username.
#
# Format: <id>:<runlevels>:<action>:<process>

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Shell straight on the serial console - no getty, no login
console::respawn:/usr/bin/lcd-shell

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
