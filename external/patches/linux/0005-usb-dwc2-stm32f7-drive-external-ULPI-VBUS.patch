--- a/drivers/usb/dwc2/params.c
+++ b/drivers/usb/dwc2/params.c
@@ -162,6 +162,14 @@
 	p->host_rx_fifo_size = 622;
 	p->host_nperio_tx_fifo_size = 128;
 	p->host_perio_tx_fifo_size = 256;
+	/*
+	 * The F7 HS port uses an external ULPI PHY (USB3320 on the
+	 * STM32F769I-DISCO) whose CPEN output switches the board's VBUS
+	 * supply. ST's HAL sets GUSBCFG.ULPIEVBUSD for this port
+	 * (use_external_vbus = 1); without it the PHY never asserts CPEN
+	 * and CN15 stays unpowered in host mode.
+	 */
+	p->phy_ulpi_ext_vbus = true;
 }
 
 static void dwc2_set_stm32mp15_fsotg_params(struct dwc2_hsotg *hsotg)
